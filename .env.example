# Kage - copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Backend ---------------------------------------------------------------
KAGE_HOST=127.0.0.1
KAGE_PORT=8000
KAGE_API=http://127.0.0.1:8000
# KAGE_RELOAD=1

# --- Voiceover inference ----------------------------------------------------
# Narration needs ONE of these. A provider with no key is skipped, not failed.
# Google AI Studio - free, no card, ~1500 req/day   https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# OpenRouter - free ':free' models, 20/min 50/day   https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# NVIDIA NIM - free developer tier, no card         https://build.nvidia.com
# NVIDIA_API_KEY=

# Override the measured routing order if you need a specific model.
# KAGE_VISION_CHAIN=gemini:gemini-2.5-flash-lite,openrouter:google/gemma-4-31b-it:free
# KAGE_TEXT_CHAIN=gemini:gemini-2.5-flash-lite

# --- Serverless GPU for image-to-video --------------------------------------
# Modal Starter includes $30/month of credits, but a payment method is required before
# any GPU function will run - verified against a real account: both L4 and T4 were
# refused with "Please add a payment method", and the gate is account-wide rather than
# per-GPU. CPU functions run without one. https://modal.com/settings/tokens
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# --- Optional ---------------------------------------------------------------
# HF_TOKEN=hf_your_token_here        # only for downloading model weights
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BINARY=C:\ffmpeg\bin\ffprobe.exe

# --- Development ------------------------------------------------------------
# Point the app at a different SQLite file. The test suite sets this to a temp file
# automatically (see tests/conftest.py), so running the tests can no longer write into
# the database the app is using. Set it by hand to work against a copy of real data
# without risking the original:
#
#   cp data/kage.db /tmp/scratch.db
#   KAGE_DB=/tmp/scratch.db .venv/Scripts/python.exe launcher.py
#
# Must be a file path. ":memory:" will not work: the app opens the database from
# several threads and each connection would get its own empty one.
# KAGE_DB=
#
# Move the engine and the studio off their default ports. Worth doing when a dev
# instance is already running - three tests once passed against stale services that
# happened to be listening on 8000 and 8501.
# KAGE_PORT=8000
# KAGE_UI_PORT=8501
